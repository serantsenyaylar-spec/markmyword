# =============================================================================
# Mark My Words — secrets template.
# Copy this file to `.streamlit/secrets.toml` and fill in real values.
# NEVER commit the real secrets.toml (it is gitignored).
# =============================================================================

# --- AI engines (at least one is required) ---
GEMINI_API_KEY = ""
GROQ_API_KEY = ""

# --- Supabase ---
# Use the anon/publishable key. Do NOT use the service_role key in a
# client-facing deployment (it bypasses all Row Level Security).
SUPABASE_URL = ""
SUPABASE_KEY = ""

# --- Google Workspace (optional; enables Drive upload & Sheets export) ---
# JSON service-account credentials (scopes are restricted to spreadsheets
# and drive.file by the app).
gcp_service_account = ""
DRIVE_FOLDER_ID = ""
SHEET_ID = ""

# --- Access control ---
# Comma-separated list of admin emails (or TOML list).
ADMIN_EMAILS = ""
# Only accounts on this domain may log in.
ALLOWED_DOMAIN = "istek.k12.tr"

# --- Notifications (optional) ---
# Long, random topic name recommended. When NTFY_TOKEN is set, the topic is
# treated as protected and only holders of the token can read/publish.
NTFY_TOPIC = ""
NTFY_TOKEN = ""

# --- DEV-ONLY auth bypass (local testing) ---
# BOTH switches must be true for the bypass to activate. Never enable them in
# a hosted environment — anyone who can reach the app is then authenticated
# as the bypass account below.
DEV_AUTH_BYPASS = "false"
ALLOW_DEV_BYPASS = "false"
DEV_AUTH_BYPASS_EMAIL = ""
DEV_AUTH_BYPASS_NAME = "Dev Teacher"
