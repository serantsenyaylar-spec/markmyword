# =============================================================================
# Mark My Words — .streamlit/secrets.toml  (TEMPLATE)
# For the supported GitHub + Streamlit Community Cloud deployment, enter these
# values only in Community Cloud → App settings → Secrets. This is an explanatory
# template; do not create or commit a filled-in local secrets file.
#
# TOML note: every top-level app setting is intentionally placed BEFORE the
# [auth] table at the end. TOML has no "return to root" marker after a table.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. AI GRADING ENGINES
# -----------------------------------------------------------------------------
# Gemini is used for structured grading/calibration only. It is NOT used for
# scanned-PDF/image OCR in this Azure-only route.
GEMINI_API_KEY = ""

# Groq is the primary grading engine when configured; Gemini remains a fallback.
GROQ_API_KEY = ""

# -----------------------------------------------------------------------------
# 2. AZURE DOCUMENT INTELLIGENCE READ OCR
# -----------------------------------------------------------------------------
# Native PDF text stays local and is used first. Scanned PDFs and JPG/PNG files
# are sent server-to-server to this Azure resource for Read OCR.
#
# Keep endpoint/key only in Streamlit server-side secrets. Never commit them,
# put them in browser code, or paste them into chat/issues.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT = ""     # e.g. https://RESOURCE.cognitiveservices.azure.com
AZURE_DOCUMENT_INTELLIGENCE_KEY = ""
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION = "2024-11-30"
AZURE_DOCUMENT_INTELLIGENCE_LOCALE = "en"     # blank = Azure automatic language detection
AZURE_DOCUMENT_INTELLIGENCE_POLL_TIMEOUT_SECONDS = "120"
AZURE_DOCUMENT_INTELLIGENCE_POLL_INTERVAL_SECONDS = "1"

# F0 is the safe default. F0/free mode is hard-limited in the app to 4 MB and
# two PDF pages, preventing Azure's partial two-page response from being used
# as a complete student submission. Set S0 only for a school-controlled,
# approved Standard Azure resource.
AZURE_DOCUMENT_INTELLIGENCE_PRICING_TIER = "F0" # F0 or S0

# Confidence is a review cue, never a grade, accuracy guarantee, or pass mark.
OCR_LOW_CONFIDENCE_THRESHOLD = "0.80"
OCR_REQUEST_TIMEOUT_SECONDS = "90"

# -----------------------------------------------------------------------------
# 3. SUPABASE (learning loop, exemplars, audit log)
# -----------------------------------------------------------------------------
# Server-side Streamlit secret only — never expose in browser code.
# With the service-role key, Postgres RLS is bypassed by design, so the app
# enforces the per-teacher ownership boundary itself.
SUPABASE_URL = ""
SUPABASE_KEY = ""

# -----------------------------------------------------------------------------
# 4. GOOGLE WORKSPACE (optional; Sheets export and locked-grade reports)
# -----------------------------------------------------------------------------
# This service account is for Sheets/Drive only. It is not an OCR credential.
gcp_service_account = ""
SHEET_ID = ""
DRIVE_FOLDER_ID = ""

# -----------------------------------------------------------------------------
# 5. MOBILE PUSH ALERTS (ntfy.sh)
# -----------------------------------------------------------------------------
NTFY_TOPIC = ""
NTFY_TOKEN = ""          # optional; required only for a protected/private topic

# -----------------------------------------------------------------------------
# 6. ACCESS CONTROL
# -----------------------------------------------------------------------------
ALLOWED_DOMAIN = "istek.k12.tr"
ADMIN_EMAILS = "serant.senyaylar@istek.k12.tr"

# -----------------------------------------------------------------------------
# 7. DEV-ONLY AUTH BYPASS — LEAVE ALL THREE UNSET IN PRODUCTION
# -----------------------------------------------------------------------------
# The bypass needs all three conditions, so an accidental hosted deployment
# fails closed: APP_ENV in {development, dev, local, test}, plus both flags.
# APP_ENV = ""
# ALLOW_DEV_BYPASS = ""
# DEV_AUTH_BYPASS = ""
# DEV_AUTH_BYPASS_EMAIL = ""   # optional; must be an allowed/admin address
# DEV_AUTH_BYPASS_NAME = ""    # optional display name

# -----------------------------------------------------------------------------
# 8. GOOGLE OAUTH — REQUIRED FOR "Log in with Google"
# -----------------------------------------------------------------------------
# Setup: Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# → Web application. Add the appropriate Streamlit redirect URI.
[auth]
redirect_uri = "https://markmyword.streamlit.app/oauth2callback"
cookie_secret = "GENERATE_ME_with_secrets.token_urlsafe(32)"

[auth.google]
client_id = "xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
