# =============================================================================
# Mark My Words — .streamlit/secrets.toml  (TEMPLATE)
# Copy to .streamlit/secrets.toml and fill in. NEVER commit the filled file:
# .gitignore already excludes .streamlit/secrets.toml.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. GOOGLE OAUTH  *** REQUIRED — WITHOUT THIS, "Log in with Google" FAILS ***
# -----------------------------------------------------------------------------
# Streamlit raises StreamlitAuthError if any of these are missing. The [auth]
# block was entirely absent from the previous template, so a fresh deployment
# could not authenticate anyone.
#
# Setup: Google Cloud Console -> APIs & Services -> Credentials ->
#         OAuth client ID -> type "Web application", then add BOTH of these to
#         "Authorised redirect URIs":
#           https://markmyword.streamlit.app/oauth2callback
#           http://localhost:8501/oauth2callback      (for local dev)
#
# redirect_uri MUST end in /oauth2callback — Streamlit enforces this.
# cookie_secret: any long random string. Generate with:
#           python -c "import secrets; print(secrets.token_urlsafe(32))"

[auth]
redirect_uri = "https://markmyword.streamlit.app/oauth2callback"
cookie_secret = "GENERATE_ME_with_secrets.token_urlsafe(32)"

[auth.google]
client_id = "xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Optional: ask Google to re-prompt for the account chooser each time.
# [auth.google.client_kwargs]
# prompt = "select_account"

# -----------------------------------------------------------------------------
# 2. AI ENGINES
# -----------------------------------------------------------------------------
# --- Google Gemini API: grading (primary) AND handwriting/OCR transcription ---
# Handwritten scans and scanned PDFs REQUIRE this key. Without it, students'
# photos are skipped and only typed TXT/DOCX files can be graded.
GEMINI_API_KEY = ""

# --- Groq API: grading fallback when Gemini is saturated/refuses ---
GROQ_API_KEY = ""

# -----------------------------------------------------------------------------
# 3. SUPABASE (learning loop, exemplars, audit log)
# -----------------------------------------------------------------------------
# Server-side Streamlit secret only — never expose in browser code.
# With the service-role key, Postgres RLS is bypassed by design, so the app
# enforces the per-teacher ownership boundary itself (see the portfolio
# lookup in Tab 3 and the is_admin checks in the Admin tab).
SUPABASE_URL = ""
SUPABASE_KEY = ""

# -----------------------------------------------------------------------------
# 4. GOOGLE WORKSPACE (optional; enables the Sheets grade export)
# -----------------------------------------------------------------------------
# JSON service-account credentials as a single-line string.
# The app requests only the spreadsheets + drive.file scopes, so this account
# needs no broad Drive access.
gcp_service_account = ""
SHEET_ID = ""

# Optional: target folder for uploads. NOTE: DRIVE_FOLDER_ID is read by app.py
# but nothing currently calls upload_file_to_drive(), so setting this alone
# does nothing. Wire up the call in the grade-locking flow first (see report).
DRIVE_FOLDER_ID = ""

# -----------------------------------------------------------------------------
# 5. MOBILE PUSH ALERTS (ntfy.sh)
# -----------------------------------------------------------------------------
# Pick a long, unguessable topic — anyone who knows it can read/post to it.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(16))"
# Install the ntfy app on the department head's phone and subscribe to it.
NTFY_TOPIC = ""
NTFY_TOKEN = ""          # optional; required only for a protected/private topic

# -----------------------------------------------------------------------------
# 6. ACCESS CONTROL
# -----------------------------------------------------------------------------
# Domain allowed to log in. Must NOT include the leading "@".
ALLOWED_DOMAIN = "istek.k12.tr"

# Comma-separated admins. These accounts see the Admin tab and may search
# across all teachers' records. Defaults to serant.senyaylar@istek.k12.tr if unset.
ADMIN_EMAILS = "serant.senyaylar@istek.k12.tr"

# -----------------------------------------------------------------------------
# 7. DEV-ONLY AUTH BYPASS — LEAVE ALL THREE UNSET IN PRODUCTION
# -----------------------------------------------------------------------------
# The bypass needs ALL three of the following to be true at once, so an
# accidental copy of this file into a hosted deployment fails closed.
#   APP_ENV         in {development, dev, local, test}
#   ALLOW_DEV_BYPASS = "true"
#   DEV_AUTH_BYPASS  = "true"
# APP_ENV = ""
# ALLOW_DEV_BYPASS = ""
# DEV_AUTH_BYPASS = ""
# DEV_AUTH_BYPASS_EMAIL = ""   # optional; must itself be an allowed/admin address
# DEV_AUTH_BYPASS_NAME = ""    # optional display name
