# =============================================================================
# Mark My Words — secrets template.
# Copy this file to `.streamlit/secrets.toml` and fill in real values.
# NEVER commit the real secrets.toml (it is gitignored).
# =============================================================================

# --- AI engines (at least one is required) ---
GEMINI_API_KEY = ""
GROQ_API_KEY = ""

# --- Supabase ---
# This Streamlit app runs database calls server-side. Its current OAuth flow
# does not mint a Supabase user JWT, so an anon key cannot satisfy the RLS
# policies in supabase/migrations. If database features are enabled, use a
# service_role key ONLY in this untracked server-side secrets file; never pass
# it to browser code or a client-side app. The application additionally scopes
# non-admin portfolio searches by teacher_email.
SUPABASE_URL = ""
SUPABASE_KEY = ""

# --- Google Workspace (optional; enables Drive upload & Sheets export) ---
# JSON service-account credentials (scopes are restricted to spreadsheets
# and drive.file by the app).
gcp_service_account = ""
DRIVE_FOLDER_ID = ""
SHEET_ID = ""

# --- Access control ---
# Comma-separated list of admin emails (or TOML list).
ADMIN_EMAILS = ""
# Only accounts on this domain may log in.
ALLOWED_DOMAIN = "istek.k12.tr"

# --- Notifications (optional) ---
# Long, random topic name recommended. When NTFY_TOKEN is set, the topic is
# treated as protected and only holders of the token can read/publish.
NTFY_TOPIC = ""
NTFY_TOKEN = ""

# --- DEV-ONLY auth bypass (local testing) ---
# The bypass requires ALL THREE conditions below: APP_ENV must be a local/dev/
# test value and BOTH switches must be true. Keep APP_ENV="production" and
# both switches false in every hosted deployment.
APP_ENV = "production"
DEV_AUTH_BYPASS = "false"
ALLOW_DEV_BYPASS = "false"
DEV_AUTH_BYPASS_EMAIL = ""
DEV_AUTH_BYPASS_NAME = "Dev Teacher"

# --- Streamlit Google OAuth (required for teacher login) ---
# Register the redirect URI for every deployment URL with Google. Generate a
# long, random cookie_secret and keep all values in the untracked real file.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = ""

[auth.google]
client_id = ""
client_secret = ""
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
