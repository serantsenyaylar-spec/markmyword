[server]
# Streamlit's default is 200 MB. 10 MB is a deliberate tightening and matches
# MAX_UPLOAD_BYTES in app.py, which is where the limit is actually enforced
# (app.py:852). Keep the two in step or the stricter one silently wins.
maxUploadSize = 10

[client]
# ADDED. Streamlit's default is "full", which prints the entire traceback —
# file paths, library versions, and any data in the failing frame — into every
# teacher's browser. This app handles student work and OAuth'd staff emails.
#
# Valid values: "full" (default) | "stacktrace" | "type" | "none"
# Set it back to "full" temporarily when you need to debug a deployment.
showErrorDetails = "none"

[browser]
# ADDED. Opts out of Streamlit's anonymous usage telemetry.
gatherUsageStats = false

# NOTE: `client.allowedOrigins` is deliberately NOT set. Streamlit 1.62 already
# defaults it to a list that includes https://*.streamlit.app, so your deployed
# origin works. Overriding it without including that pattern would break the
# live app, which is a common and confusing self-inflicted outage.

[theme]
base="dark"
primaryColor="#3B82F6"
backgroundColor="#0F172A"
secondaryBackgroundColor="#1E293B"
textColor="#F8FAFC"
font="sans serif"

# All seven keys above were checked against Streamlit 1.62's option registry
# (342 options) — every one is a real, correctly spelled option. Nothing here
# needed fixing.
